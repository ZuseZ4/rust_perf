+  /// Release the kernel-argument buffers of finished launches: all recorded
+  /// ones up to \p UntilSlot if given, otherwise those whose signal reached
+  /// zero. The stream mutex must be held.
+  Error releaseKernelArgs(std::optional<uint32_t> UntilSlot = std::nullopt) {
+    while (!InFlightKernelArgs.empty()) {
+      auto [Slot, Buffer] = InFlightKernelArgs.front();
